# ── Configuracoes do Ekobelth para Windows ──

# Banco de Dados MySQL
EKOBELTH_DB_HOST=localhost
EKOBELTH_DB_PORT=3306
EKOBELTH_DB_USER=root
EKOBELTH_DB_PASSWORD=
EKOBELTH_DB_NAME=ekobelth

# Servico de IA Eko (Ollama) - Opcional
OLLAMA_BASE_URL=http://localhost:11434
IA_EKO_MODELO=llama3.2:1b
IA_EKO_TIMEOUT=120

# Usuario Administrador padrao para testes
EKOBELTH_ADMIN_EMAIL=admin@admin.com
EKOBELTH_ADMIN_SENHA=admin
EKOBELTH_ADMIN_NOME=Admin
